meta {
  name: Iniciar Sesión (Supervisor)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "supervisor",
    "password": "Demo2026!"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("token", res.body.accessToken);
    bru.setEnvVar("refreshToken", res.body.refreshToken);
  }
}